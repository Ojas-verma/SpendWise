PORT=3000
N8N_BASE_URL=http://127.0.0.1:5679
N8N_WEBHOOK_PATH=spendwise-v1
# Generate locally. Use the same value in n8n Header Auth, name X-SpendWise-Key.
N8N_WEBHOOK_SECRET=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
APP_TIMEZONE=Asia/Kolkata
# Compose uses the existing local image after migration; do not pull a new image implicitly.
N8N_IMAGE=n8nio/n8n:spendwise-local
# Local MongoDB. npm run setup:mongodb generates private passwords in .env.
MONGO_HOST_PORT=27018
MONGO_DATABASE=spendwise
MONGO_INITDB_ROOT_USERNAME=spendwise_admin
MONGO_INITDB_ROOT_PASSWORD=
MONGO_APP_USERNAME=spendwise_app
MONGO_APP_PASSWORD=
